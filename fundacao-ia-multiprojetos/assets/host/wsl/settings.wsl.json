{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa*)",
      "Read(./**/*credentials*)",
      "Read(./**/*secret*)",
      "Read(./**/*.kdbx)",
      "Read(./**/auth.json)",
      "{{SEGREDOS_DA_REGRA_UNICA}}",
      "Read(/{{RAIZ}}/state/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.ssh/**)",
      "Read(/{{PERFIL_WINDOWS}}/.claude/.credentials.json)",
      "Read(/{{PERFIL_WINDOWS}}/.codex/auth.json)",
      "Read(/{{PERFIL_WINDOWS}}/.ssh/**)",
      "{{LEITURA_NEGADA}}",
      "{{WEB_NEGADA}}",
      "Edit(/{{RAIZ}}/.claude/**)",
      "Edit(/{{RAIZ}}/registry/**)",
      "Edit(/{{PROJETO_DIR}}/.claude/**)",
      "Edit(/{{PROJETO_DIR}}/.porteiro/respostas/**)",
      "Edit(/{{PROJETO_DIR}}/CLAUDE.local.md)",
      "Edit(/{{ANCORA_BASE}}/**)",
      "Edit(/{{SOMENTE_LEITURA}}/**)"
    ],
    "allow": ["{{WEBFETCH_PERMITIDO}}"]
  },
  "claudeMdExcludes": ["**/projects/*/data/**"],
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "disableClaudeAiConnectors": true,
  "env": {
    "FUNDACAO_PRINCIPAL": "sessao-{{PROJETO}}",
    "FUNDACAO_PROJECT": "{{PROJETO}}",
    "FUNDACAO_RAIZ": "{{RAIZ}}",
    "FUNDACAO_PORTEIRO": "{{PROJETO_DIR}}/.porteiro",
    "FUNDACAO_FERRAMENTAS": "{{FERRAMENTAS}}",
    "FUNDACAO_MCP_PERMITIDAS": "",
    "FUNDACAO_DOMINIOS_WEB": "{{DOMINIOS_WEB}}",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "PYTHONPATH": "{{RAIZ}}",
    "XDG_CACHE_HOME": "{{PROJETO_DIR}}/.cache",
    "npm_config_cache": "{{PROJETO_DIR}}/.cache/npm",
    "PIP_CACHE_DIR": "{{PROJETO_DIR}}/.cache/pip",
    "UV_CACHE_DIR": "{{PROJETO_DIR}}/.cache/uv"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["-I", "-B", "{{HOOK_SINAIS}}"],
            "timeout": 3,
            "onFailure": "block",
            "statusMessage": "sinais_sessao: lembrando a retomada após compactação"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["-I", "-B", "{{HOOK_SINAIS}}"],
            "timeout": 3,
            "onFailure": "block",
            "statusMessage": "sinais_sessao: as regras da sessão para o subagente"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["-I", "-B", "{{HOOK_FERRAMENTAS}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_ferramentas: só as ferramentas da lista do projeto"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["-I", "-B", "{{HOOK_CAMINHO}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_caminho: conferindo destino da escrita"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["-I", "-B", "{{HOOK_IDENTIDADE}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_identidade: conferindo troca de identidade e caminho de outro projeto"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["-I", "-B", "{{HOOK_REDE}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_rede: só os domínios da ficha do projeto"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["-I", "-B", "{{HOOK_LEITURA}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_leitura: outro projeto e state/ ficam fora"
          }
        ]
      }
    ]
  },
  "statusLine": {"type": "command", "command": "{{STATUS_SINAIS}}"},
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [],
      "denyWrite": [
        "{{RAIZ}}/.claude",
        "{{RAIZ}}/registry",
        "{{PROJETO_DIR}}/.claude",
        "{{PROJETO_DIR}}/.porteiro/respostas",
        "{{PROJETO_DIR}}/CLAUDE.local.md",
        "{{RAIZ}}/projects/{{OUTROS_PROJETOS}}",
        "{{SOMENTE_LEITURA}}",
        "{{ANCORA_BASE}}"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.claude/.credentials.json",
        "~/.codex",
        "{{PERFIL_WINDOWS}}/.ssh",
        "{{PERFIL_WINDOWS}}/.claude/.credentials.json",
        "{{PERFIL_WINDOWS}}/.codex"
      ],
      "allowRead": ["{{RAIZ}}/fundacao", "{{ANCORA_BASE}}", "{{SOMENTE_LEITURA}}", "{{TEMP_PROJETO}}"]
    },
    "network": {
      "allowedDomains": ["{{REDE_PERMITIDA}}"],
      "strictAllowlist": true
    }
  }
}
