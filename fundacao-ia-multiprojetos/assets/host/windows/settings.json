{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa*)",
      "Read(./**/*credentials*)",
      "Read(./**/*secret*)",
      "Read(./**/*.kdbx)",
      "Read(./**/auth.json)",
      "Read(./state/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.ssh/**)",
      "Edit(./.claude/**)"
    ]
  },
  "claudeMdExcludes": ["**/projects/*/data/**"],
  "env": {
    "FUNDACAO_MCP_PERMITIDAS": "mcp__ccd_*"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-I", "-B", "{{HOOK_SINAIS}}"],
            "timeout": 3,
            "onFailure": "block",
            "statusMessage": "sinais_sessao: lembrando a retomada após compactação"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{HOOK_CAMINHO}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_caminho: conferindo destino da escrita"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{HOOK_IDENTIDADE}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_identidade: conferindo troca de identidade"
          }
        ]
      }
    ]
  },
  "statusLine": {"type": "command", "command": "{{STATUS_SINAIS}}"}
}
