{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa*)",
      "Read(./**/*credentials*)",
      "Read(./**/*secret*)",
      "Read(./**/*.kdbx)",
      "Read(./**/auth.json)",
      "{{SEGREDOS_DA_REGRA_UNICA}}",
      "Read(./state/**)",
      "Read(./projects/*/data/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.ssh/**)",
      "{{LEITURA_NEGADA}}",
      "WebFetch",
      "WebSearch",
      "Edit(./.claude/**)",
      "Edit(./registry/projetos-host.json)",
      "{{EDICAO_NEGADA}}"
    ]
  },
  "claudeMdExcludes": ["**/projects/*/data/**"],
  "env": {
    "FUNDACAO_MCP_PERMITIDAS": "mcp__ccd_*",
    "FUNDACAO_RAIZ": "{{RAIZ}}",
    "FUNDACAO_SEM_DADOS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-I", "-B", "{{HOOK_SINAIS}}"],
            "timeout": 3,
            "onFailure": "block",
            "statusMessage": "sinais_sessao: lembrando a retomada após compactação"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-I", "-B", "{{HOOK_AVISO}}"],
            "timeout": 5,
            "statusMessage": "aviso_copia: idade da última cópia de segurança"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-I", "-B", "{{HOOK_CAMINHO}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_caminho: conferindo destino da escrita"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-I", "-B", "{{HOOK_IDENTIDADE}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_identidade: conferindo troca de identidade e caminho de outro projeto (guarda-corpo)"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-I", "-B", "{{HOOK_REDE}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_rede: sessões do Windows sem web"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-I", "-B", "{{HOOK_LEITURA}}"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guarda_leitura (guarda-corpo: no Windows não há sandbox e o shell lê tudo)"
          }
        ]
      }
    ]
  },
  "statusLine": {"type": "command", "command": "{{STATUS_SINAIS}}"}
}
